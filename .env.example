# Kopieren nach .env und Werte anpassen (.env wird nicht committet)

# Datenbank
POSTGRES_DB=sportplatzfinder
POSTGRES_USER=sportplatzfinder
POSTGRES_PASSWORD=change-me
# Port auf dem Host (ändern, falls 5432 schon belegt ist)
DB_HOST_PORT=5432

# Keycloak (Container folgt später)
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/sportplatzfinder

KEYCLOAK_HOST_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me